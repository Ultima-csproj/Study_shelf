# PowerShell: set these environment variables before cargo run.
# DATABASE_URL=postgres://study_dev:YOUR_PASSWORD@127.0.0.1:5433/study_dev
BIND_ADDRESS=127.0.0.1:3000
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=604800
# Exact browser origins. Local HTTP requires a loopback BIND_ADDRESS.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# HTTPS deployment: AUTH_COOKIE_SECURE=true and https://... origins only.
